# SupportFlow AI — Environment Variables
# Copy this to .env and fill in your values

# Database: defaults to SQLite for instant local dev. For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:pass@host:5432/supportflow
DATABASE_URL=sqlite:///./supportflow.db

# Security
SECRET_KEY=supportflow-secret-key-change-in-production-abc123

# Gemini API Key (optional — app works without it using rule-based fallback agent)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=models/text-embedding-004

# Human-in-the-loop: refunds above this amount require human approval
HIGH_RISK_REFUND_THRESHOLD=100.0
